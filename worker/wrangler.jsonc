{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telkal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // https://telkal.<サブドメイン>.workers.dev を有効にする（Next.js サーバーから呼び出す URL）
  "workers_dev": true,
  // ブランチごとのプレビュー URL は使わない（本番データベースに接続されるため）
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telkal",
      "database_id": "b83e604e-7243-413c-a97b-0e8699aa57c1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // ブラウザから直接呼ぶ想定はないため既定では空（CORS を許可しない）。
    // 必要な場合のみカンマ区切りで本番オリジンを指定してください。
    "ALLOWED_ORIGINS": "",
    "SESSION_TTL_DAYS": "30"
  }
  // 秘密情報 INTERNAL_API_SECRET は `wrangler secret put INTERNAL_API_SECRET`（本番）
  // または .dev.vars（ローカル）で設定します。
}
